<?xml version="1.0"?>
<package format="3">
  <name>vehicle_bridge</name>
  <version>0.1.0</version>
  <description>Owns the Jetson to UNO Q serial link; actuator command bridge with host-side safety policy.</description>
  <maintainer email="dev@example.com">CHEESECC</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>vehicle_interfaces</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
